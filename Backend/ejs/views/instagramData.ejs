<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>instagram</title>
  <link rel="stylesheet" href="/style.css">
 
  </head>
  <body>
    <center>
      <h1>Instagram</h1>
    </center>
    <hr />
    <h2>This page belongs to @ <%=instaData.name %></h2>
    <button>Followers</button>
    <button>Message</button>

    <p>
      Follwers : <%= instaData.followers %> &nbsp;&nbsp;&nbsp;&nbsp; Follwing:
      <%= instaData.following %>
    </p>
    <hr />

    <% for(let post of instaData.posts){ %>
        <img src="<%= post.image %>" alt="some img">
         <p>
      Likes : <%= post.likes  %> &nbsp;&nbsp;&nbsp;&nbsp; Comments:
      <%= post.comments %>
    </p>
    <% } %>

     <script src="/app.js"></script>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>store</title>
    <style>
      form {
        display: inline-flex;
        flex-direction: column;
        width: 50%;
      }
    </style>
  </head>
  <body>
    <h1>Edit your store data</h1>

    <form method="POST" action="/store/<%= data._id %>?_method=PUT">
      <label for="">Title</label>
      <input type="text" name="title" value="<%= data.title %>" />
      <br /><br />
      <label for="">Description </label>
      <textarea type="text" name="description">
        <%= data.description %>
        </textarea
      >
      <br /><br />
      <label for="">Image</label>
      <input type="text" name="image" value="<%= data.image %>" />
      <br /><br />
      <label for="">Price</label>
      <input type="text" name="price" value="<%= data.price %>" />
      <br /><br />
      <label for="">Category</label>
      <input type="text" name="category" value="<%= data.category %>" />
      <br /><br />
      <label for="">Brand</label>
      <input type="text" name="brand" value="<%= data.brand %>" />
      <br /><br />
      <label for="">Stock</label>
      <input type="text" name="stock" value="<%= data.stock %>" />
      <br /><br />
      <button>Save</button>
    </form>
  </body>
</html>
